/* gimp42.rc - the Windows resources of gimp42.exe: its icon and version.
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */
#include <winver.h>

1 ICON "gimp42.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,4,0
PRODUCTVERSION  1,0,4,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "The gimp42 project"
      VALUE "FileDescription",  "GIMP42 - GNU Image Manipulation Program"
      VALUE "FileVersion",      "1.0.4"
      VALUE "InternalName",     "gimp42"
      VALUE "LegalCopyright",   "GPL-2.0-or-later"
      VALUE "OriginalFilename", "gimp42.exe"
      VALUE "ProductName",      "GIMP42"
      VALUE "ProductVersion",   "1.0.4"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
